<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>10.0.0</Version>
	<PackageId>DataJuggler.XmlMirror.RunTime.NETCore</PackageId>
    <Description>This package is a port of the .Net Framework version XMLMirror.Runtime

XML Mirror makes it easy to Create Xml Parsers and Readers.</Description>
    <Copyright>DataJuggler 2012 - 2026 - Use For Whatever You Want.</Copyright>
    <PackageLicenseFile>License.txt</PackageLicenseFile>
    <PackageProjectUrl>https://github.com/DataJuggler/XmlMirror</PackageProjectUrl>
    <PackageIcon>Xml Mirror plus Xml Text.png</PackageIcon>
    <RepositoryUrl>https://github.com/DataJuggler/XmlMirror.git</RepositoryUrl>
    <RepositoryType>Git / Git Hub</RepositoryType>
    <PackageReleaseNotes>This version is a direct port to .Net 6. All the code works exactly the same, although
possibly faster due to the perforamance improvements of .NET 10.

From now on, only this version will be updated.</PackageReleaseNotes>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <ApplicationIcon>XML Icon.ico</ApplicationIcon>
    <Nullable>disable</Nullable>
    <PackageTags>C#;XML;</PackageTags>
    <PackageReadmeFile>ReadMe.md</PackageReadmeFile> 
  </PropertyGroup>

  <ItemGroup>
    <Content Include="XML Icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Images\Xml Mirror plus Xml Text.png">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
    <None Include="License\License.txt">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DataJuggler.UltimateHelper" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Images\" />
  </ItemGroup>

  <ItemGroup>
    <None Update="ReadMe.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
